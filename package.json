{
  "name": "dogcatify",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node scripts/expo-start.js --lan",
    "dev": "node scripts/expo-start.js --clear --lan",
    "web": "node scripts/expo-start.js --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package",
    "populate-illness-cache": "node scripts/populate-illness-cache.js",
    "lint": "expo lint",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/supabase/functions/"
    ]
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-av"
        ]
      }
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.43.2",
    "@types/react": "~19.1.10",
    "ajv": "^8.12.0",
    "ajv-keywords": "^5.1.0",
    "dotenv": "^17.2.3",
    "expo": "^57.0.0",
    "expo-auth-session": "~57.0.13",
    "expo-av": "~16.0.8",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "jspdf": "^3.0.1",
    "lucide-react-native": "^0.469.0",
    "process": "^0.11.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-super-grid": "^6.0.1",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-transform-runtime": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@react-native-community/cli": "^19.1.1",
    "@react-native/jest-preset": "^0.86.3",
    "@react-native/metro-config": "^0.83.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "patch-package": "^8.0.1",
    "react-native-svg-transformer": "^1.5.1",
    "stream-browserify": "^3.0.0",
    "typescript": "~6.0.3"
  }
}
